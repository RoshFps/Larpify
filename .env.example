# Copy this file to .env.local and fill it in. .env.local is git-ignored.
#
# Client ID from https://developer.spotify.com/dashboard.
# It is a public identifier, not a secret, but keep it out of git anyway so
# each person runs the app against their own Spotify app.
VITE_SPOTIFY_CLIENT_ID=

# Optional. Must exactly match a Redirect URI in the Spotify dashboard.
# Defaults to the address the app is served from, e.g. http://127.0.0.1:5173/
# VITE_SPOTIFY_REDIRECT_URI=

# Optional. Sub-path when hosting somewhere like GitHub Pages, e.g. /Larpify/
# VITE_BASE_PATH=/
